# Supabase project → Connect. A publishable key is safe in the browser; never use service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Select a Responses API model supporting streaming and structured output in your account.
OPENAI_MODEL=

# Server-only database writer for verified learning evidence. NEVER use NEXT_PUBLIC_.
# A Supabase secret key (recommended) or legacy service_role key:
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
